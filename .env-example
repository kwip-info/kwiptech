# Django Settings
DEBUG=True
SECRET_KEY=insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,kwip.tech,www.kwip.tech

# Local Development Database (Docker)
# For local development with Docker Compose, use:
DATABASE_URL=postgres://pyscoped:pyscoped@db:5432/pyscoped_plane

# On Heroku, DATABASE_URL is automatically set by the Heroku Postgres add-on
# You don't need to configure it manually in production

# pyscoped Dogfooding
# API key for the management plane's own pyscoped instance (optional in dev)
# SCOPED_API_KEY=psc_live_your_key_here

# Clerk Authentication
# Get these from: https://dashboard.clerk.com -> your app -> API Keys
# CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Email Settings
# For development, use console backend to see emails in terminal:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, configure your email provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email_user
# EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@kwip.info

# Stripe Settings
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
